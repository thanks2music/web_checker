service cloud.firestore {
  match /databases/{database}/documents {
    // ヘルパー関数: 認証済みかつ承認済みユーザーかどうか
    function isApprovedUser() {
      return request.auth != null && request.auth.token.approved == true;
    }

    // schedules コレクション
    match /schedules/{scheduleId} {
      // 承認済みユーザーのみ読み書き可能
      allow read: if isApprovedUser();
      allow create: if isApprovedUser()
        && request.resource.data.uri is string
        && request.resource.data.selector is string
        && request.resource.data.title is string;
      allow update: if isApprovedUser();
      allow delete: if isApprovedUser();

      // archives サブコレクション（読み取りのみ許可、書き込みは Functions から）
      match /archives/{archiveId} {
        allow read: if isApprovedUser();
        // クライアントからの書き込みは禁止（Functions の Admin SDK からのみ書き込み）
        allow write: if false;
      }
    }
  }
}
