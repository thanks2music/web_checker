{
  "name": "web-checker",
  "version": "0.0.0",
  "private": true,
  "description": "Web page change monitoring app with Slack notifications (Firebase Cloud Functions + Firestore + Hosting)",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "test": "pnpm -r run test",
    "dev:web": "pnpm --filter @revolution/web-checker-web run dev",
    "deploy": "firebase deploy"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
