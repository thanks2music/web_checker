{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --silent",
    "devtest": "jest --silent=false --verbose"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.9.0",
    "@slack/webhook": "^7.0.4",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cron-parser": "^4.9.0",
    "diff": "^7.0.0",
    "firebase-admin": "^13.0.1",
    "firebase-functions": "^6.1.2",
    "iconv-lite": "^0.6.3",
    "jschardet": "^3.1.4"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.12",
    "firebase-functions-test": "^3.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "private": true
}
