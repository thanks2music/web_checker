# Local development environment variables.
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#
# In production these values are managed by Cloud Secret Manager
# (registered with `firebase functions:secrets:set <NAME>`) and mounted
# on the functions that declare them in `secrets: [...]`.
# See docs/plan/2026-07-25-modernization-and-integration-plan.md §8.1.

# Slack Incoming Webhook URL used by the slackNotifier function.
# Secret Manager name: SLACK_URL_REVOLUTION_WEB_CHECKER
SLACK_URL_REVOLUTION_WEB_CHECKER=https://hooks.slack.com/services/XXXXX/XXXXX/XXXXXXXXXXXXX
