# firebase
.firebase

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
#
# `.env` alone does not match `.env.local` / `.env.production` etc — gitignore
# patterns are literal, not prefixes. Without the wildcard below, `web/.env.local`
# (which holds the real Firebase web config) would be committable to a public repo.
.env
.env.*
# ...but the templates are meant to be tracked.
!.env.example
!.env.sample

# next.js build output
.next
# `next build` with output: 'export' writes here; Firebase Hosting serves it.
out
# incremental build cache from tsc
*.tsbuildinfo

# docs/ is ignored by default because it also holds a vendored copy of the
# Firebase documentation (docs/firebase/), which is large and not ours to track.
docs/**

# ...but the design history is tracked. These are the only record of why the
# codebase looks the way it does, and Phase 2 imports this repository as a
# single squashed commit — anything left untracked disappears at that point.
#
# This repository is public, so account identifiers (email addresses, billing
# account IDs, GCP project IDs other than this project's) are redacted to
# placeholders before anything lands here.
!docs/plan/
!docs/plan/**
!docs/review/
!docs/review/**
!docs/debug/
!docs/debug/**
